* text=auto

*.bib text eol=lf
*.ipynb text eol=lf
*.json text eol=lf
*.md text eol=lf
*.py text eol=lf
*.tex text eol=lf
*.txt text eol=lf
*.yaml text eol=lf
*.yml text eol=lf

*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary

# Datos versionados byte a byte: sin conversión de fin de línea ni diffs. Los
# CSV de UNSW-NB15 usan CRLF; si Git los normalizara, cambiarían sus sumas
# SHA-256 y la verificación de s4-datos-carga fallaría.
data/** binary

*.ipynb	diff=jupyternotebook

*.ipynb	merge=jupyternotebook
